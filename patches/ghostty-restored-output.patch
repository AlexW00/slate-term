+    /// Read fresh PTY output without the historical text restored into the display.
+    export fn ghostty_surface_read_session_text(surface: *Surface, result: *Text) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+
+        if (core_surface.io.fresh_output) |fresh| {
+            if (!fresh.available) return false;
+            const screen = fresh.terminal.screens.active;
+            const end = screen.pages.getBottomRight(.screen) orelse return false;
+            const text = screen.selectionString(global.alloc(), .{
+                .sel = .init(screen.pages.getTopLeft(.screen), end, false),
+                .trim = false,
+            }) catch return false;
+            result.* = .{ .tl_px_x = -1, .tl_px_y = -1, .offset_start = 0, .offset_len = 0, .text = text.ptr, .text_len = text.len };
+            return true;
+        }
+        const screen = core_surface.io.terminal.screens.active;
+        const end = screen.pages.getBottomRight(.screen) orelse return false;
+        return readTextLocked(surface, .init(screen.pages.getTopLeft(.screen), end, false), result);
+    }
+
