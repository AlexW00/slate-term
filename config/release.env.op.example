# Copy outside every checkout to ~/.config/slate-term/release.env.op (mode 600).
# Use existing 1Password fields containing single-line base64 for the P12 and P8.
# These are references, never literal credentials. Replace vault/item/field names.
SLATE_RELEASE_CERTIFICATE_P12_BASE64="op://Release/Slate Release/certificate-base64"
SLATE_RELEASE_CERTIFICATE_PASSWORD="op://Release/Slate Release/certificate-password"
SLATE_NOTARY_KEY_P8_BASE64="op://Release/Slate Release/notary-key-base64"
SLATE_NOTARY_KEY_ID="op://Release/Slate Release/notary-key-id"
SLATE_NOTARY_ISSUER_ID="op://Release/Slate Release/notary-issuer-id"
